# Variables de Cloud Functions (NO usar prefijo VITE_; nunca llegan al bundle del cliente)
# Cuenta Gmail remitente. Tambien es el destinatario principal ("correo de Felipe").
GMAIL_USER=
# Destinatarios admin extra separados por coma (opcional; por defecto GMAIL_USER)
MAIL_ADMIN_TO=
# true = tambien envia la Gran Final en copia oculta (BCC) a los inscritos con pago verificado
MAIL_NOTIFY_PARTICIPANTS=true
# true = compone y registra el correo pero NO lo envia
MAIL_DRY_RUN=false
# URL publica de la app para los enlaces del correo
APP_URL=https://spinapptorneo.web.app
# GMAIL_APP_PASSWORD es un SECRETO: configuralo con
#   firebase functions:secrets:set GMAIL_APP_PASSWORD
# (en el emulador local puedes ponerlo en functions/.secret.local)
