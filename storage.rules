rules_version = '2';

// Reglas de Firebase Storage para spinApp
service firebase.storage {
  match /b/{bucket}/o {

    // Avatares de jugador: solo el dueño escribe; imagen de hasta 3 MB.
    match /usuarios/{uid}/{allPaths=**} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 3 * 1024 * 1024;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Biblioteca de videos y miniaturas (módulo biblioteca): lectura pública,
    // escritura de usuarios autenticados (mismo comportamiento previo a estas reglas).
    match /biblioteca/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Todo lo demás queda cerrado por defecto
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
