VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_ID=default
VITE_USE_FIREBASE_EMULATOR=true

# Cloudinary (fotos de perfil, videos y miniaturas). Plan gratuito.
# Cloud name: panel de Cloudinary > Dashboard. Preset: Settings > Upload > Upload presets (modo Unsigned).
# NUNCA pongas aqui el API secret.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=

# Solo Cloud Functions (copiar a functions/.env). NUNCA con prefijo VITE_
GMAIL_USER=
# Secreto en produccion: firebase functions:secrets:set GMAIL_APP_PASSWORD
GMAIL_APP_PASSWORD=
