rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función: ¿Está el usuario autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función: ¿Es el usuario el dueño del recurso?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Función: ¿Tiene el usuario rol de 'admin'?
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Reglas para la colección 'usuarios'
    match /usuarios/{userId} {
      // Cualquiera autenticado puede leer usuarios (necesario para ver rivales)
      allow read: if isAuthenticated();
      // Solo el mismo usuario al registrarse (con rol 'jugador') o un admin pueden crear el perfil
      // Al registrarse no puede autoasignarse ranking ni elo
      allow create: if isAuthenticated() && (
        (isOwner(userId) &&
          request.resource.data.rol == 'jugador' &&
          !request.resource.data.keys().hasAny(['puntosRanking', 'elo'])) ||
        isAdmin()
      );
      // El dueño solo edita campos de perfil (nombre, apellido, telefono, fotoUrl, tipo...).
      // Campos sensibles (rol, ranking, elo, email, createdAt) solo los cambia un admin.
      allow update: if isAuthenticated() && (
        isAdmin() || (
          isOwner(userId) &&
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['rol', 'puntosRanking', 'elo', 'email', 'createdAt', 'id'])
        )
      );
      allow delete: if isAdmin();
    }

    // Reglas para la colección 'torneos'
    match /torneos/{torneoId} {
      allow read: if isAuthenticated();
      // Solo admins pueden crear, actualizar o borrar torneos
      allow write: if isAdmin();
    }

    // Reglas para la colección 'inscripciones'
    match /inscripciones/{inscripcionId} {
      allow read: if isAuthenticated();
      // Un usuario puede inscribirse a sí mismo con pagoValidado=false. Admin puede inscribir o validar.
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isOwner(request.resource.data.jugadorId) && 
          request.resource.data.pagoValidado == false
        )
      );
      allow update, delete: if isAdmin();
    }

    // Reglas para la colección 'partidos'
    match /partidos/{partidoId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();

      // Subcolección para señalización WebRTC P2P de transmisiones en vivo
      match /stream_peers/{peerId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }

      // Subcolección para chat en tiempo real del stream
      match /stream_chat/{chatId} {
        allow read: if true;
        // Solo usuarios autenticados pueden comentar, asegurando su propio usuarioId
        allow create: if isAuthenticated() && request.resource.data.usuarioId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // Subcolección para reacciones en vivo
      match /reacciones/{reacId} {
        allow read: if true;
        allow write: if isAuthenticated();
      }
    }

    // Reglas para la colección 'tablas_posiciones'
    match /tablas_posiciones/{tablaId} {
      allow read: if isAuthenticated();
      // Solo el admin persiste la tabla oficial. Los jugadores la calculan en el cliente
      // a partir de 'partidos' (useTorneoGrupo) y no escriben aquí.
      allow write: if isAdmin();
    }

    // Llaves de eliminatorias (Fase 2). Las crea el admin al cerrar grupos y solo el admin
    // registra resultados / avanza ganadores (transacción en resolverPartidoPlayoffDB).
    match /partidos_playoffs/{partidoId} {
      allow read: if isAuthenticated();
      allow create, update: if isAdmin() &&
        request.resource.data.fase == 'playoff' &&
        request.resource.data.torneoId is string &&
        request.resource.data.ronda in ['play_in', 'cuartos', 'semifinal', 'final'];
      allow delete: if isAdmin();
    }

    // Reglas para la colección 'biblioteca_videos' (Grabaciones, Repeticiones y Clips)
    match /biblioteca_videos/{videoId} {
      allow read: if true;
      // Solo admins pueden crear clips manualmente; las transmisiones completadas se pueden registrar de forma automática
      allow create: if isAuthenticated() && (
        isAdmin() || request.resource.data.tipo == 'transmision_completa'
      );
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }
  }
}
