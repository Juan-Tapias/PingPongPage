rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función: ¿Está el usuario autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función: ¿Es el usuario el dueño del recurso?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Función: ¿Tiene el usuario rol de 'admin'?
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Reglas para la colección 'usuarios'
    match /usuarios/{userId} {
      // Cualquiera autenticado puede leer usuarios (necesario para ver rivales)
      allow read: if isAuthenticated();
      // Solo el mismo usuario o un admin puede actualizar su perfil
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId) || isAdmin();
    }

    // Reglas para la colección 'torneos'
    match /torneos/{torneoId} {
      allow read: if isAuthenticated();
      // Solo admins pueden crear, actualizar o borrar torneos
      allow write: if isAdmin();
    }

    // Reglas para la colección 'inscripciones'
    match /inscripciones/{inscripcionId} {
      allow read: if isAuthenticated();
      // Un usuario puede inscribirse a sí mismo. Admin puede hacer lo que sea.
      allow create: if isOwner(request.resource.data.jugadorId) || isAdmin();
      allow update, delete: if isAdmin();
    }

    // Reglas para la colección 'partidos'
    match /partidos/{partidoId} {
      allow read: if isAuthenticated();
      // Cualquier autenticado puede actualizar un partido (ej. arbitraje), pero admins tienen control total
      allow create: if isAdmin();
      // Idealmente, validaríamos que el usuario autenticado NO sea jugador1 ni jugador2 en el partido,
      // pero para mantener la flexibilidad (como el árbitro que no pite su propio partido),
      // lo validamos también desde el cliente. Para mayor seguridad:
      allow update: if isAuthenticated() && (isAdmin() || (
        request.auth.uid != resource.data.jugador1Id && 
        request.auth.uid != resource.data.jugador2Id
      ));
      allow delete: if isAdmin();
    }

    // Reglas para la colección 'tablas_posiciones'
    match /tablas_posiciones/{tablaId} {
      allow read: if isAuthenticated();
      // Las posiciones pueden actualizarse como resultado de un partido
      allow write: if isAuthenticated();
    }
  }
}
