rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función: ¿Está el usuario autenticado?
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Función: ¿Es el usuario el dueño del recurso?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Función: ¿Tiene el usuario rol de 'admin'?
    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Reglas para la colección 'usuarios'
    match /usuarios/{userId} {
      // Cualquiera autenticado puede leer usuarios (necesario para ver rivales)
      allow read: if isAuthenticated();
      // Solo el mismo usuario al registrarse (con rol 'jugador') o un admin pueden crear el perfil
      allow create: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.rol == 'jugador') || isAdmin()
      );
      // El usuario puede editar sus datos sin cambiar su propio rol; el admin tiene control total
      allow update: if isAuthenticated() && (
        isAdmin() || (isOwner(userId) && request.resource.data.rol == resource.data.rol)
      );
      allow delete: if isAdmin();
    }

    // Reglas para la colección 'torneos'
    match /torneos/{torneoId} {
      allow read: if isAuthenticated();
      // Solo admins pueden crear, actualizar o borrar torneos
      allow write: if isAdmin();
    }

    // Reglas para la colección 'inscripciones'
    match /inscripciones/{inscripcionId} {
      allow read: if isAuthenticated();
      // Un usuario puede inscribirse a sí mismo con pagoValidado=false. Admin puede inscribir o validar.
      allow create: if isAuthenticated() && (
        isAdmin() || (
          isOwner(request.resource.data.jugadorId) && 
          request.resource.data.pagoValidado == false
        )
      );
      allow update, delete: if isAdmin();
    }

    // Reglas para la colección 'partidos'
    match /partidos/{partidoId} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();

      // Subcolección para señalización WebRTC P2P de transmisiones en vivo
      match /stream_peers/{peerId} {
        allow read, write: if true;
      }

      // Subcolección para reacciones en vivo
      match /reacciones/{reacId} {
        allow read, write: if true;
      }
    }

    // Reglas para la colección 'tablas_posiciones'
    match /tablas_posiciones/{tablaId} {
      allow read: if isAuthenticated();
      // Las posiciones pueden actualizarse como resultado de un partido
      allow write: if isAuthenticated();
    }
  }
}
